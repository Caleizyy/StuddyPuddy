# Used by `docker compose up --build`. Copy to .env to override the demo defaults.
# (backend/.env.example is the separate file for running the API without Docker.)

# A long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Leave empty to use the MongoDB container. For MongoDB Atlas paste its connection string.
MONGODB_URI=

# The address people open in the browser
CORS_ORIGIN=http://localhost:8080
WEB_PORT=8080
