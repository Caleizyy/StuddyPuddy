NODE_ENV=development
PORT=3000
# Local MongoDB by default. For Atlas, paste your mongodb+srv:// connection string here.
MONGODB_URI=mongodb://localhost:27017/studdypuddy
CORS_ORIGIN=http://localhost:5173
