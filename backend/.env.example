NODE_ENV=development
PORT=3000
# Local MongoDB by default. For Atlas, paste your mongodb+srv:// connection string here.
MONGODB_URI=mongodb://localhost:27017/studdypuddy
CORS_ORIGIN=http://localhost:5173
# Used only by `npm run seed`: the password given to the seeded test users
SEED_PASSWORD=
# Any long random string
JWT_SECRET=
JWT_EXPIRES_IN=7d
# The seed script deletes ALL users, tasks and availability in this database.
# Set to true only when you are sure MONGODB_URI points at a database you can wipe.
ALLOW_SEED_WIPE=false